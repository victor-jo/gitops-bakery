# Argo CD Application for {{name}}, created by gitops-bakery; it follows apps/{{name}}-manifests
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{name}}
  namespace: argocd
  # Without this finalizer, removing the Application would leave the Deployment and NodePort Service running
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: {{gitlabUrl}}/apps/{{name}}-manifests.git
    targetRevision: main
    path: .
  destination:
    server: https://kubernetes.default.svc
    namespace: app-{{name}}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
